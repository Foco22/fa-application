{
  "name": "paper-learning",
  "version": "1.0.0",
  "description": "Sistema de aprendizaje continuo de papers científicos",
  "main": "main.js",
  "scripts": {
    "start": "electron-rebuild -f -w better-sqlite3 && electron .",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.5.1",
    "fast-xml-parser": "^4.4.0",
    "katex": "^0.18.1",
    "marked": "^18.0.5",
    "node-cron": "^3.0.3",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@vitest/coverage-v8": "^2.0.0",
    "electron": "^31.0.0",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^29.1.1",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "node-gyp": "^11.0.0"
  }
}
